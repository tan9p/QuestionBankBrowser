<Window x:Class="QuestionBankBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="高中题库浏览器"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Padding="10" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="38"
                         VerticalContentAlignment="Center"
                         FontSize="16"
                         Margin="0,0,8,0"
                         KeyDown="SearchBox_KeyDown"/>

                <Button Grid.Column="1"
                        x:Name="SearchButton"
                        Content="搜索"
                        Width="80"
                        Height="38"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="2"
                        Content="清空"
                        Width="70"
                        Height="38"
                        Click="ClearButton_Click"/>

                <Button Grid.Column="3"
                        Content="上一题"
                        Width="80"
                        Height="38"
                        Click="PreviousButton_Click"/>

                <Button Grid.Column="4"
                        Content="下一题"
                        Width="80"
                        Height="38"
                        Click="NextButton_Click"/>
            </Grid>
        </Border>

        <!-- 筛选 -->
        <Border Grid.Row="1"
                Padding="8"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="年份" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <ComboBox x:Name="YearCombo"
                          Width="110"
                          SelectionChanged="FilterChanged"/>

                <TextBlock Text="题型" VerticalAlignment="Center" Margin="15,0,4,0"/>
                <ComboBox x:Name="TypeCombo"
                          Width="120"
                          SelectionChanged="FilterChanged"/>

                <TextBlock Text="来源" VerticalAlignment="Center" Margin="15,0,4,0"/>
                <ComboBox x:Name="SourceCombo"
                          Width="180"
                          SelectionChanged="FilterChanged"/>

                <Button Content="刷新筛选"
                        Margin="15,0,4,0"
                        Click="ReloadFiltersButton_Click"/>

                <TextBlock x:Name="CountText"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>
            </StackPanel>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：题目列表 -->
            <Border Grid.Column="0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            Padding="8">
                        <TextBlock Text="题目列表"
                                   FontWeight="Bold"/>
                    </Border>

                    <ListBox x:Name="QuestionList"
                             Grid.Row="1"
                             BorderThickness="0"
                             SelectionChanged="QuestionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,7"
                                        BorderBrush="#EEEEEE"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Year}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Source}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding QuestionNo}"/>
                                            <Run Text="题"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Type}"
                                                   Foreground="#777777"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Content}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="42"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- 右：题目预览 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="12,8"
                        Background="#F7F7F7"
                        BorderBrush="#DDDDDD"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PreviewTitle"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="PreviewMeta"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#777777"/>
                        <Button x:Name="CopyImageButton"
                                Content="复制为图片"
                                Margin="18,0,0,0"
                                Padding="10,4"
                                Click="CopyImageButton_Click"
                                IsEnabled="False"/>
                        <Button x:Name="CopyLatexButton"
                                Content="复制 LaTeX 源码"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Click="CopyLatexButton_Click"
                                IsEnabled="False"/>
                        <Button x:Name="CopyOfficeButton"
                                Content="复制 Word/PPT 块"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Click="CopyOfficeButton_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <wv2:WebView2 Grid.Row="1"
                          x:Name="QuestionWebView"/>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="#666666"/>
        </Border>
    </Grid>
</Window>
